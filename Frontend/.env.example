# Public HTTPS origin in production, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana Devnet payment configuration.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=
MERCHANT_WALLET=
MERCHANT_ID=merchant-aria-studio

# Current active persistence mode. Only "json" is supported by the business
# store; it is local-only and not durable on Vercel/serverless.
DATA_STORE=json

# Server-only values reserved for the staged Supabase adapter.
# Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
