# Public HTTPS origin in production, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privy authentication. Any authenticated user receives a merchant workspace.
# The app secret is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Solana Devnet payment configuration.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=

# Dedicated Devnet-only fee payer. This must be a base64 encoding of the
# keypair's 64-byte secret key. Keep it server-only and never commit a value.
SOLANA_SPONSOR_SECRET_KEY_BASE64=

# Current active persistence mode. Only "json" is supported by the business
# store; it is local-only and not durable on Vercel/serverless.
DATA_STORE=json

# Optional persistent directory for hosts with a mounted volume (for example,
# mount a Railway volume at /data and set DATA_DIR=/data).
# When omitted, BlinkShop uses ${process.cwd()}/data.
DATA_DIR=

# Optional legacy Railway JSON migration inputs only. These values may claim
# old Aria Studio records that predate per-product payout wallets. They do not
# authorize dashboard access and are never used for new products.
PRIVY_MERCHANT_USER_ID=
MERCHANT_WALLET=

# Server-only values reserved for the staged Supabase adapter.
# Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
